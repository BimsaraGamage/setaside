{
  "name": "setaside",
  "version": "0.1.14",
  "private": true,
  "description": "Set aside the commitments of each pay cycle and see the free money and daily allowance left.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:money": "vitest run --project money",
    "test:server": "vitest run --project server",
    "e2e": "playwright test",
    "types": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "deploy": "wrangler deploy",
    "feedback": "node scripts/feedback.mjs",
    "feedback:auto": "node scripts/feedback-auto.mjs"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.22",
    "@zumer/snapdom": "3.7.6",
    "better-auth": "^1.7.22",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@cloudflare/vite-plugin": "^1.69.1",
    "@cloudflare/vitest-plugin": "^1.8.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "^0.31.11",
    "fast-check": "^4.10.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "wrangler": "^4.161.0"
  },
  "allowScripts": {
    "workerd@1.20261110.1": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
