{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "setaside",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // Address: setaside.<account-name>.workers.dev. Preview URLs stay off: they would use live data.
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "setaside",
      // Filled in at first-time setup (see docs/self-hosting.md). Not a secret.
      "database_id": "7b85adf9-5a21-493d-8026-f2d979fcf292",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // The live address, filled in at first-time setup (see docs/self-hosting.md). Passkeys and
    // Google sign-in are bound to it. Local development uses the dev server's own address.
    "APP_URL": "https://setaside.dragantravica269.workers.dev"
  },
  // Set once by hand with `wrangler secret put` (spec 18). Locally: optional, see .dev.vars.example.
  // Phone alerts add two optional secrets, VAPID_PUBLIC_KEY and VAPID_PRIVATE_KEY (docs/self-hosting.md).
  "secrets": {
    "required": ["BETTER_AUTH_SECRET", "ALLOWED_EMAILS", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET"]
  },
  // Reminders (spec 12, item 26): one run every 15 minutes (UTC) sends what is due.
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": { "enabled": true }
}
